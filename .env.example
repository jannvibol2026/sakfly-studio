# ─────────────────────────────────────────────────────────────
# SAKFLY Studio — Environment Variables (example)
# Copy this file to .env.local and fill in real values.
# NEVER commit real secrets to version control.
# ─────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=SAKFLY Studio

# ── Firebase (Client SDK) ────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# ── Firebase (Admin SDK — server only) ───────────────────────
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# ── Google Cloud / Vertex AI ──────────────────────────────────
GOOGLE_APPLICATION_CREDENTIALS=./gcp-service-account.json
VERTEX_AI_PROJECT_ID=your-gcp-project-id
VERTEX_AI_LOCATION=us-central1
VERTEX_AI_GEMINI_MODEL=gemini-1.5-pro
VERTEX_AI_IMAGEN_MODEL=imagegeneration@006
VERTEX_AI_TTS_MODEL=tts-1
VERTEX_AI_LYRIA_MODEL=lyria-001

# ── Stripe ────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_PUBLISHABLE_KEY=pk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
STRIPE_PRICE_PRO=price_placeholder_pro_monthly
STRIPE_PRICE_PROPLUS=price_placeholder_proplus_monthly

# ── Email (contact form) ─────────────────────────────────────
CONTACT_EMAIL_TO=hello@sakflystudio.com
EMAIL_SERVER_API_KEY=your_email_provider_api_key
